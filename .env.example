# Copy to .env and fill in. .env is ignored by git. Real environment variables override it.

# REQUIRED: Valetudo address of your robot (or "mock" for a fake robot)
ROBOROCK_URL=http://192.168.1.50

# SSH private key for root on the robot, used only by the lidar/sensor tap (step 3)
ROBOROCK_SSH_KEY=~/.ssh/roborock

# Set to 0 if you did not install the tap (no SSH connection attempts)
ROBOROCK_TAP=1

# Where the panel listens. Keep 127.0.0.1 unless you know what you expose: the panel has no login.
ROBOROCK_PANEL_HOST=127.0.0.1
ROBOROCK_PANEL_PORT=8780

# For mcp_server.py: address of the running panel (set it in your MCP client config if you changed the port)
ROBOROCK_PANEL=http://127.0.0.1:8780
